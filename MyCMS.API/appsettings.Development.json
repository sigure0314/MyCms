{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LiveKit": {
    "ApiKey": "YOUR_LIVEKIT_API_KEY",
    "ApiSecret": "YOUR_LIVEKIT_API_SECRET",
    "Url": "wss://your-livekit-domain",
    "TokenTtlMinutes": 30
  },
  "BetterStack": {
    "SourceToken": "YOUR_LOGTAIL_SOURCE_TOKEN",
    "SourceId": "YOUR_LOGTAIL_SOURCE_ID"
  },
  "Youtube": {
    "ApiKey": "YOUR_YOUTUBE_API_KEY",
    "VideoInput": "https://www.youtube.com/watch?v=YOUR_VIDEO_ID"
  }
}
